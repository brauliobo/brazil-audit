#!/usr/bin/env ruby
# Prints how many sections with files of their own are still missing their info file in the cache (0 = all downloaded)
require 'active_support/all'
%w[config http cache state].each{ |f| require_relative "../lib/#{f}" }

cached = Dir.children("#{DATA_DIR}/ballots").to_set

pending = STATES.sum do |state|
  state = state.downcase
  Hashie::Mash.new(JSON.parse State.get(state, fetch: false).data).abr.first.mu.sum do |city|
    city.zon.sum{ |zone| zone.sec.count{ |s| State.own?(s) && !cached.include?([state, city.cd, zone.cd, s.ns].join('-')) } }
  end
end
puts pending
