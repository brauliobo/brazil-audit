#!/bin/bash
# Scrapes the 2026 election over and over until every section with files of its own is cached and stored, or until
# STALL passes in a row bring nothing new (the TSE has not published the rest yet): run it again later to resume.
# Each pass reloads the missing files of every section and stores the votes not stored yet (see lib/stored.rb).
#
# Env: PROXIES  file with one `host port user pass` per line (required, requests rotate through them)
#      THREADS  threads per level (default 8)
#      STALL    passes without progress before stopping (default 3)
#      DB_NAME  database (default brazil-audit-2026)
set -e
cd "$(dirname "$0")/.."
: "${PROXIES:?set PROXIES to a file with one 'host port user pass' per line}"
export PROXIES YEAR=2026 THREADS=${THREADS:-8}
STATES_COUNT=28 # 26 states, DF and the foreign vote (zz)
STORED="2026/stored/${DB_NAME:-brazil-audit-2026}"

progress() { echo $(( $(ls 2026/ballots | wc -l) + $(ls "$STORED" | wc -l) )); }

mkdir -p tmp
last=$(progress)
stalled=0
while :; do
  mv -f tmp/scrape-2026.log tmp/scrape-2026.prev.log 2>/dev/null || true
  nice -n 10 ruby script.rb >> tmp/scrape-2026.log 2>&1 || true
  pending=$(ruby bin/pending)
  [ "$(ls 2026/states | wc -l)" = "$STATES_COUNT" ] && [ "$pending" = 0 ] && break
  now=$(progress)
  [ "$now" = "$last" ] && stalled=$((stalled + 1)) || stalled=0
  last=$now
  [ "$stalled" -ge "${STALL:-3}" ] && { echo "stalled: $pending sections still without info file" >> tmp/scrape-2026.log; break; }
  sleep 20
done
echo "done: $(ls 2026/ballots | wc -l) sections, $(ls "$STORED" | wc -l) stored" >> tmp/scrape-2026.log
